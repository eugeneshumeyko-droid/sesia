        .icon-arrow {
            transition: transform 0.3s;
        }
        .accordion-button.active .icon-arrow {
            transform: rotate(180deg);
        }
        
        /* Math/Latex styling - REMOVED LATEX DEPENDENCY */
        .math-display {
            font-size: var(--font-size-base);
            font-family: 'Courier New', monospace; /* Use monospace for formulas without MathJax */
            display: block;
            margin: 0.5rem 0;
            padding: 0.75rem;
            background-color: var(--secondary-bg-color);
            border-radius: 0.5rem;
            border-left: 4px solid var(--accent-color);
            white-space: pre-wrap; 
            line-height: 1.5;
        }

        /* Flashcard Styling */
        .flashcard-window-content {
            min-height: 200px;
            perspective: 1000px;
        }
        .flashcard-small {
            height: 100%;
            width: 100%;
            position: absolute;
            transform-style: preserve-3d;
            transition: transform 0.6s;
            cursor: pointer;
        }
        .flashcard-small.flipped {
            transform: rotateY(180deg);
        }
        .flashcard-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 0.5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            padding: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            line-height: 1.4;
            font-size: var(--font-size-sm);
        }
        .flashcard-front {
            background-color: var(--accent-color);
            color: white;
            font-weight: bold;
        }
        .flashcard-back {
            background-color: var(--card-bg-color);
            color: var(--text-default);
            border: 2px solid var(--accent-color);
            transform: rotateY(180deg);
            overflow-y: auto;
        }

        /* Settings Drawer (Modal) */
        #settings-drawer {
            transition: transform 0.3s ease-in-out;
            transform: translateX(100%);
            z-index: 200; /* High z-index for drawer */
        }
        #settings-drawer.open {
            transform: translateX(0);
        }
        #settings-overlay {
            z-index: 150; /* Z-index for overlay */
        }

        /* Draggable Window Styles */
        .floating-window {
            position: absolute;
            width: 300px;
            min-height: 250px;
            max-height: 90vh; /* Max height to prevent resizing off screen */
            background-color: var(--card-bg-color);
            border-radius: 0.75rem;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
            z-index: 100;
            resize: both; /* Enable resizing */
            overflow: hidden; /* Hide content when resizing */
            border: 2px solid var(--primary-color);
            transition: box-shadow 0.2s, width 0.3s, height 0.3s, top 0.3s, left 0.3s; /* Added transitions */
            display: flex;
            flex-direction: column;
            pointer-events: auto; /* IMPORTANT for interaction */
        }
        .dark .floating-window {
            border: 2px solid var(--accent-color);
        }
        .floating-window-header {
            cursor: grab;
            user-select: none;
            padding: 0.5rem 1rem;
            background-color: var(--primary-color);
            color: white;
            border-top-left-radius: 0.65rem;
            border-top-right-radius: 0.65rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: var(--font-size-sm);
            font-weight: 600;
            flex-shrink: 0; /* Prevents header from shrinking */
        }
        .floating-window-content-wrapper {
            padding: 0 1rem 1rem;
            flex-grow: 1; /* Allows content wrapper to take remaining space */
            overflow-y: auto; /* Scrollable content area */
        }
        .tab-btn-small {
            padding: 0.3rem 0.5rem;
            font-size: 0.75rem;
            border-radius: 0.5rem;
            transition: background-color 0.2s;
        }
        
        /* NEW: Maximized window style */
        .floating-window.maximized {
            width: 100vw !important; /* Full viewport width */
            height: 100vh !important; /* Full viewport height */
            top: 0 !important;
            left: 0 !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            resize: none !important; /* Disable resizing when maximized */
            z-index: 500 !important; /* Ensure it's above everything */
        }
    </style>
</head>
