    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class', // Enable dark mode based on 'dark' class
            theme: {
                extend: {
                    colors: {
                        'primary-default': 'var(--primary-color, #1e3a8a)', // Dark Blue base
                        'primary-accent': 'var(--accent-color, #3b82f6)',  // Bright Blue accent
                        'secondary-bg': 'var(--secondary-bg-color, #f9fafb)', // Very Light Gray
                        'card-bg': 'var(--card-bg-color, #ffffff)',
                        'text-default': 'var(--text-color, #1f2937)',
                        'text-secondary': 'var(--text-secondary-color, #6b7280)',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    fontSize: {
                        'base-size': 'var(--font-size-base, 1rem)',
                        'sm-size': 'var(--font-size-sm, 0.875rem)',
                    }
                }
            }
        }

        // Default theme settings
        const defaultTheme = {
            '--primary-color': '#1e3a8a',
            '--accent-color': '#3b82f6',
            '--secondary-bg-color': '#f9fafb',
            '--card-bg-color': '#ffffff',
            '--text-color': '#1f2937',
            '--text-secondary-color': '#6b7280',
            '--font-size-base': '1rem',
            '--font-size-sm': '0.875rem',
        };

        // Dark theme settings
        const darkTheme = {
            '--primary-color': '#93c5fd', // Light blue for contrast
            '--accent-color': '#60a5fa',
            '--secondary-bg-color': '#1f2937',
            '--card-bg-color': '#374151',
            '--text-color': '#f3f4f6',
            '--text-secondary-color': '#d1d5db',
        };

        // Apply initial theme settings
        function applyTheme(isDark) {
            const root = document.documentElement;
            const theme = isDark ? darkTheme : defaultTheme;
            if (isDark) {
                root.classList.add('dark');
            } else {
                root.classList.remove('dark');
            }
            for (const [key, value] of Object.entries(theme)) {
                root.style.setProperty(key, value);
            }
            // Preserve font size setting
            root.style.setProperty('--font-size-base', localStorage.getItem('fontSizeBase') || defaultTheme['--font-size-base']);
            root.style.setProperty('--font-size-sm', localStorage.getItem('fontSizeSm') || defaultTheme['--font-size-sm']);
        }
        
        // Initial setup from localStorage
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        applyTheme(isDarkMode);

        // Function to toggle dark mode
        function toggleDarkMode(isDark) {
            localStorage.setItem('darkMode', isDark);
            applyTheme(isDark);
            // Update the checkbox if called externally
            const toggle = document.getElementById('dark-mode-toggle');
            if (toggle) toggle.checked = isDark;
        }

        // Function to change accent color
        function changeAccentColor(primary, accent) {
            document.documentElement.style.setProperty('--primary-color', primary);
            document.documentElement.style.setProperty('--accent-color', accent);
            localStorage.setItem('primaryColor', primary);
            localStorage.setItem('accentColor', accent);
            // Re-apply preserved font sizes in case of theme switch
            applyFontSize(localStorage.getItem('fontSizeBase') === '1.125rem');
        }

        // Function to change font size
        function applyFontSize(isLarge) {
            const base = isLarge ? '1.125rem' : '1rem';
            const sm = isLarge ? '1rem' : '0.875rem';
            document.documentElement.style.setProperty('--font-size-base', base);
            document.documentElement.style.setProperty('--font-size-sm', sm);
            localStorage.setItem('fontSizeBase', base);
            localStorage.setItem('fontSizeSm', sm);
        }

        // Initialize with stored color if available
        document.addEventListener('DOMContentLoaded', () => {
            const storedPrimary = localStorage.getItem('primaryColor');
            const storedAccent = localStorage.getItem('accentColor');
            if (storedPrimary && storedAccent) {
                changeAccentColor(storedPrimary, storedAccent);
            }
            // Initialize font size control
            const isLarge = localStorage.getItem('fontSizeBase') === '1.125rem';
            applyFontSize(isLarge);
            const sizeToggle = document.getElementById('font-size-toggle');
            if (sizeToggle) sizeToggle.checked = isLarge;
        });

    </script>
    <style>
        /* Base styles using variables */
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--secondary-bg-color);
            color: var(--text-default);
