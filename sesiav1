                        flashcards: [
                            { term: "Головна ознака безособових дієслів", definition: "Означають дію/стан, що відбувається сам по собі, не мають підмета." },
                            { term: "Форми безособових дієслів", definition: "3 ос. одн. тепер./майб. часу або середній рід мин. часу." },
                        ]
                    },
                    {
                        title: "§22. НЕ з дієсловами (С. 79-81)",
                        content: `
                            <p>Найчастіше **НЕ** з дієсловами пишеться <span class="font-bold text-red-500">ОКРЕМО</span>:</p>
                            <span class="math-display">Не бачив, не знаєш, не прийшов.</span>
                            <p>Пишеться <span class="font-bold text-green-600">РАЗОМ</span>, якщо:</p>
                            <ul class="list-disc ml-6 space-y-1 mt-2">
                                <li>Дієслово без <span class="font-bold">не</span> не вживається (наприклад, <span class="text-green-600 font-bold">нехтувати, ненавидіти, непокоїти</span>).</li>
                                <li><span class="font-bold">Не</span> є префіксом, що утворює нове дієслово (наприклад, <span class="text-green-600 font-bold">недочувати</span> (погано чути) ≠ не дочувати (не закінчувати чути)).</li>
                            </ul>
                        `,
                        flashcards: [
                            { term: "Основне правило правопису НЕ з дієсловами", definition: "ОКРЕМО (не робив, не біжи)." },
                            { term: "Випадок, коли пишеться РАЗОМ", definition: "Коли дієслово без НЕ не вживається (ненавидіти) або утворюється префікс (недочувати)." },
                        ]
                    },
                ]
            }
        };

        // --- GLOBAL STATE ---
        let windowCounter = 0;
        let activeWindows = 0;
        const maxWindows = 5;

        // --- UI/RENDER FUNCTIONS ---

        function getArrowIcon() {
            return `<svg class="icon-arrow w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>`;
        }
        
        function getWindowIcon() {
             return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>`;
        }

        function createAccordionItem(topicData, index, sectionKey) {
            return `
                <div class="mb-3 rounded-xl shadow-sm bg-card-bg hover:shadow-md transition duration-200 border border-gray-200 dark:border-gray-700">
                    <button class="accordion-button w-full flex justify-between items-center p-4 text-left font-semibold text-text-default rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-accent/50" onclick="toggleAccordion(this)">
                        <span class="flex items-center text-primary-default dark:text-primary-color">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2 text-primary-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.464 9.22 4.787 7.5 4.787c-1.879 0-3.446.843-4.148 2.079-1.55 2.15-.52 4.544 2.454 4.544.606 0 1.156-.118 1.632-.322.25-.104.475-.246.67-.406M12 6.253c1.168.789 2.78 1.465 4.5 1.465 1.879 0 3.446-.843 4.148-2.079 1.55-2.15.52-4.544-2.454-4.544-.606 0-1.156.118-1.632.322-.25.104-.475.246-.67.406" /></svg>
                            ${topicData.title}
                        </span>
                        <div class="flex items-center space-x-2">
                             <button onclick="event.stopPropagation(); createFloatingWindow(${index}, '${sectionKey}')" 
                                class="p-1 text-sm bg-primary-accent text-white rounded-full hover:bg-primary-default transition duration-200"
                                title="Відкрити урок у спливаючому вікні для паралельного повторення">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                            </button>
                            ${getArrowIcon()}
                        </div>
                    </button>
                    <div class="accordion-content bg-secondary-bg p-0 rounded-b-xl">
                        <div class="px-4 py-2 text-text-secondary font-sm-size">
                            ${topicData.content}
                            <hr class="my-4 border-gray-300 dark:border-gray-600"/>
                            <div class="text-center">
                                <p class="text-text-default font-semibold mb-2">💡 Флешкартки до цього уроку:</p>
                                <button onclick="createFloatingWindow(${index}, '${sectionKey}', true)" class="px-3 py-1 bg-primary-accent text-white rounded-lg hover:bg-primary-default transition duration-200 text-sm-size">
                                    Переглянути ${topicData.flashcards.length} карток
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
        
        function renderSection(sectionKey) {
            const sectionData = sessionTopics[sectionKey];
            let htmlContent = `<h2 class="text-2xl md:text-3xl font-bold text-primary-default mb-6 border-b border-primary-accent pb-2">${sectionData.title}</h2>`;
            
            sectionData.items.forEach((topic, index) => {
                htmlContent += createAccordionItem(topic, index, sectionKey);
            });

            document.getElementById('content-container').innerHTML = htmlContent;
        }

        // --- ACCORDION LOGIC ---
        function toggleAccordion(button) {
            const content = button.nextElementSibling;
            const isOpen = button.classList.contains('active');

            // Close all other open accordions
            document.querySelectorAll('.accordion-button').forEach(btn => {
                if (btn !== button) {
                    btn.classList.remove('active');
                    btn.nextElementSibling.style.maxHeight = null;
                }
            });

            // Toggle current accordion
            if (isOpen) {
                button.classList.remove('active');
                content.style.maxHeight = null;
            } else {
                button.classList.add('active');
                // Set max-height dynamically (with some buffer)
                content.style.maxHeight = content.scrollHeight + 50 + "px"; 
            }
        }
        
        // --- NAVIGATION LOGIC ---
        function switchView(viewName) {
            // Update active tab styles
            document.querySelectorAll('.tab-button').forEach(btn => {
                btn.classList.remove('bg-primary-accent', 'text-white', 'hover:bg-primary-accent/90');
                btn.classList.add('text-text-secondary', 'bg-secondary-bg', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');
            });
            const activeTab = document.getElementById(`tab-${viewName}`);
            activeTab.classList.add('bg-primary-accent', 'text-white', 'hover:bg-primary-accent/90');
            activeTab.classList.remove('text-text-secondary', 'bg-secondary-bg', 'hover:bg-gray-200', 'dark:hover:bg-gray-600');

            // Render content
            renderSection(viewName);
        }

        // --- FLOATING WINDOWS LOGIC ---
        let activeFlippedCards = {}; // Track flip state per window

        function createFloatingWindow(topicIndex, sectionKey, showFlashcards = false) {
            if (activeWindows >= maxWindows) {
                alert('Ви можете відкрити не більше 5 вікон одночасно для повторення.');
                return;
            }

            const topic = sessionTopics[sectionKey].items[topicIndex];
            const uniqueId = `window-${windowCounter++}`;
            activeFlippedCards[uniqueId] = false; // Initial flip state

            // Determine initial position
            // Spread windows slightly on the screen
            const x = 50 + (activeWindows * 30); 
            const y = 50 + (activeWindows * 30);

            const windowHtml = `
                <div id="${uniqueId}" class="floating-window pointer-events-auto" style="top: ${y}px; left: ${x}px; width: 350px; height: 400px; min-width: 300px; min-height: 250px;">
                    <div id="${uniqueId}-header" class="floating-window-header">
                        <span class="truncate max-w-[70%] flex items-center">${getWindowIcon()}${topic.title}</span>
                        <div class="flex space-x-1">
                            <button onclick="toggleMaximize('${uniqueId}')" class="p-1 rounded-full text-white hover:bg-yellow-500/70 transition" title="Розгорнути/Згорнути">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path id="${uniqueId}-maximize-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-4v4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                                </svg>
                            </button>
                            <button onclick="closeWindow('${uniqueId}')" class="p-1 rounded-full text-white hover:bg-red-500/70 transition">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        </div>
                    </div>
                    <div class="p-2 border-b border-gray-200 dark:border-gray-700 flex justify-around bg-secondary-bg dark:bg-gray-700 flex-shrink-0">
                        <button id="${uniqueId}-tab-lesson" onclick="switchWindowTab('${uniqueId}', 'lesson')" class="tab-btn-small bg-primary-accent text-white">Урок</button>
                        <button id="${uniqueId}-tab-flashcards" onclick="switchWindowTab('${uniqueId}', 'flashcards')" class="tab-btn-small text-text-secondary hover:bg-gray-300 dark:hover:bg-gray-600">${topic.flashcards.length} Карток</button>
                    </div>
                    <div class="floating-window-content-wrapper">
                        <div id="${uniqueId}-lesson-content" class="floating-window-tab-content pt-4">
                            ${topic.content}
                        </div>
                        <div id="${uniqueId}-flashcards-content" class="floating-window-tab-content hidden pt-4">
                            </div>
                    </div>
                </div>
            `;

            document.getElementById('floating-windows-container').insertAdjacentHTML('beforeend', windowHtml);
            
            // Render flashcards inside the new window
            renderWindowFlashcards(uniqueId, topic.flashcards);

            // Make the new window draggable and resizable
            makeDraggable(document.getElementById(uniqueId));
            activeWindows++;

            // Set initial tab
            if (showFlashcards) {
                switchWindowTab(uniqueId, 'flashcards');
            } else {
                switchWindowTab(uniqueId, 'lesson');
            }
        }

        function toggleMaximize(id) {
            const windowEl = document.getElementById(id);
            const isMaximized = windowEl.classList.contains('maximized');
            const iconEl = document.getElementById(`${id}-maximize-icon`);
            const headerEl = document.getElementById(id + '-header');

            if (isMaximized) {
                // Restore
                windowEl.classList.remove('maximized');
                
                // Re-enable dragging
                headerEl.onmousedown = dragMouseDown;
                headerEl.ontouchstart = dragTouchStart;
                
                // Restore resize ability (default is in CSS: resize: both)
                windowEl.style.resize = 'both';

                // Update icon to Maximize
                iconEl.setAttribute('d', 'M4 8V4m0 0h4M4 4l5 5m11-4v4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4');

                // Optional: You could restore size/position from stored attributes here if needed,
                // but the CSS transition will handle the smooth size change.

            } else {
                // Maximize
                windowEl.classList.add('maximized');
                
                // Disable dragging and resizing
                headerEl.onmousedown = null;
                headerEl.ontouchstart = null;
                windowEl.style.resize = 'none';

                // Update icon to Restore
                iconEl.setAttribute('d', 'M8 4H4v4m12 0h4V4m-4 20h4v-4M4 20h4v-4');
            }
        }


        function closeWindow(id) {
            const windowEl = document.getElementById(id);
            if (windowEl) {
                windowEl.remove();
                activeWindows--;
                delete activeFlippedCards[id];
            }
        }

        function switchWindowTab(windowId, tabName) {
            const lessonContent = document.getElementById(`${windowId}-lesson-content`);
            const flashcardsContent = document.getElementById(`${windowId}-flashcards-content`);
            const lessonTab = document.getElementById(`${windowId}-tab-lesson`);
            const flashcardsTab = document.getElementById(`${windowId}-tab-flashcards`);

            const windowWrapper = document.getElementById(windowId).querySelector('.floating-window-content-wrapper');

            if (tabName === 'lesson') {
                lessonContent.classList.remove('hidden');
                flashcardsContent.classList.add('hidden');
                lessonTab.classList.add('bg-primary-accent', 'text-white');
                lessonTab.classList.remove('text-text-secondary', 'bg-secondary-bg', 'dark:bg-gray-700');
                flashcardsTab.classList.remove('bg-primary-accent', 'text-white');
                flashcardsTab.classList.add('text-text-secondary', 'bg-secondary-bg', 'dark:bg-gray-700');
                windowWrapper.scrollTop = 0; // Reset scroll on tab switch
            } else if (tabName === 'flashcards') {
                lessonContent.classList.add('hidden');
                flashcardsContent.classList.remove('hidden');
                flashcardsTab.classList.add('bg-primary-accent', 'text-white');
                flashcardsTab.classList.remove('text-text-secondary', 'bg-secondary-bg', 'dark:bg-gray-700');
                lessonTab.classList.remove('bg-primary-accent', 'text-white');
                lessonTab.classList.add('text-text-secondary', 'bg-secondary-bg', 'dark:bg-gray-700');
                windowWrapper.scrollTop = 0; // Reset scroll on tab switch
            }
        }


        // --- DRAG-AND-DROP LOGIC (Updated to reference `dragMouseDown` and `dragTouchStart`) ---

        // These functions are defined globally for use in `makeDraggable` and `toggleMaximize`
        let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;

        function dragMouseDown(e) {
            e = e || window.event;
            // Only allow dragging if the window is NOT maximized
            if (e.target.closest('.floating-window').classList.contains('maximized')) return;
            e.preventDefault();
            pos3 = e.clientX;
            pos4 = e.clientY;
            document.onmouseup = closeDragElement;
            document.onmousemove = elementDrag;
        }
        
        function dragTouchStart(e) {
            e = e || window.event;
            // Only allow dragging if the window is NOT maximized
            if (e.target.closest('.floating-window').classList.contains('maximized')) return;
            if (e.target.closest('.floating-window-header')) {
                e.preventDefault(); 
                const touch = e.touches[0];
                pos3 = touch.clientX;
                pos4 = touch.clientY;
                document.ontouchend = closeDragElement;
                document.ontouchmove = elementDragTouch;
            }
        }
        
        function elementDrag(e) {
            e = e || window.event;
            e.preventDefault();
            const element = document.onmousemove.element; // Get the element being dragged
            
            pos1 = pos3 - e.clientX;
            pos2 = pos4 - e.clientY;
            pos3 = e.clientX;
            pos4 = e.clientY;
            
            let newTop = element.offsetTop - pos2;
            let newLeft = element.offsetLeft - pos1;

            // Boundary check against the viewport (since container is fixed inset-0)
            const viewportHeight = window.innerHeight;
            const viewportWidth = window.innerWidth;
            
            newTop = Math.max(0, newTop); 
            newLeft = Math.max(0, newLeft); 
            newTop = Math.min(newTop, viewportHeight - element.offsetHeight); 
            newLeft = Math.min(newLeft, viewportWidth - element.offsetWidth); 

            element.style.top = newTop + "px";
            element.style.left = newLeft + "px";
        }
        
        function elementDragTouch(e) {
            e = e || window.event;
            e.preventDefault(); 
            const element = document.ontouchmove.element; // Get the element being dragged
            const touch = e.touches[0];
            
            pos1 = pos3 - touch.clientX;
            pos2 = pos4 - touch.clientY;
            pos3 = touch.clientX;
            pos4 = touch.clientY;
            
            let newTop = element.offsetTop - pos2;
            let newLeft = element.offsetLeft - pos1;
            
            // Boundary check against the viewport
            const viewportHeight = window.innerHeight;
            const viewportWidth = window.innerWidth;
            
            newTop = Math.max(0, newTop); 
            newLeft = Math.max(0, newLeft); 
            newTop = Math.min(newTop, viewportHeight - element.offsetHeight); 
            newLeft = Math.min(newLeft, viewportWidth - element.offsetWidth); 

            element.style.top = newTop + "px";
            element.style.left = newLeft + "px";
        }


        function closeDragElement() {
            document.onmouseup = null;
            document.onmousemove = null;
            document.ontouchend = null;
            document.ontouchmove = null;
        }

        function makeDraggable(element) {
            const header = document.getElementById(element.id + '-header');

            // Attach the element being dragged to the handler functions
            document.onmousemove.element = element;
            document.ontouchmove.element = element;

            header.onmousedown = dragMouseDown;
            header.ontouchstart = dragTouchStart; 
        }

        // --- WINDOW FLASHCARD LOGIC ---

        function renderWindowFlashcards(windowId, cards) {
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index') || 0);

            if (currentCardIndex >= cards.length) currentCardIndex = 0;
            if (cards.length === 0) return;
            
            const currentCard = cards[currentCardIndex];
            const isFlipped = activeFlippedCards[windowId] || false;
            
            const cardHTML = `
                <div class="flashcard-window-content w-full h-40 relative">
                    <div id="${windowId}-flashcard" class="flashcard-small ${isFlipped ? 'flipped' : ''}" onclick="flipWindowCard('${windowId}')">
                        <div class="flashcard-face flashcard-front">
                            ${currentCard.term}
                        </div>
                        <div class="flashcard-face flashcard-back text-left">
                            ${currentCard.definition}
                        </div>
                    </div>
                </div>
            `;

            // Stringify and escape cards data for passing to onclick handlers
            const cardsString = JSON.stringify(cards).replace(/"/g, '&quot;');

            const controlsHTML = `
                <div class="flex justify-center items-center mt-4 space-x-4">
                    <button onclick="prevWindowCard('${windowId}', '${cardsString}')" class="p-2 rounded-full bg-gray-300 text-primary-default hover:bg-gray-400 disabled:opacity-50 transition duration-150 text-sm" ${currentCardIndex === 0 ? 'disabled' : ''} title="Попередня картка">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                    </button>
                    
                    <span class="text-sm font-semibold text-text-default">${currentCardIndex + 1} / ${cards.length}</span>

                    <button onclick="nextWindowCard('${windowId}', '${cardsString}')" class="p-2 rounded-full bg-gray-300 text-primary-default hover:bg-gray-400 disabled:opacity-50 transition duration-150 text-sm" ${currentCardIndex === cards.length - 1 ? 'disabled' : ''} title="Наступна картка">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            `;

            document.getElementById(`${windowId}-flashcards-content`).innerHTML = `
                <div class="bg-secondary-bg dark:bg-gray-700 p-4 rounded-lg shadow-inner">
                    ${cardHTML}
                    ${controlsHTML}
                </div>
            `;
            document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex);
        }

        function flipWindowCard(windowId) {
            const card = document.getElementById(`${windowId}-flashcard`);
            activeFlippedCards[windowId] = !activeFlippedCards[windowId];
            if (activeFlippedCards[windowId]) {
                card.classList.add('flipped');
            } else {
                card.classList.remove('flipped');
            }
        }

        function nextWindowCard(windowId, cardsString) {
            const cards = JSON.parse(cardsString.replace(/&quot;/g, '"'));
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index'));
            if (currentCardIndex < cards.length - 1) {
                document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex + 1);
                activeFlippedCards[windowId] = false; // Reset flip
                renderWindowFlashcards(windowId, cards);
            }
        }

        function prevWindowCard(windowId, cardsString) {
             const cards = JSON.parse(cardsString.replace(/&quot;/g, '"'));
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index'));
            if (currentCardIndex > 0) {
                document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex - 1);
                activeFlippedCards[windowId] = false; // Reset flip
                renderWindowFlashcards(windowId, cards);
            }
        }


        // --- SETTINGS LOGIC ---
        function toggleSettings() {
            const drawer = document.getElementById('settings-drawer');
            const overlay = document.getElementById('settings-overlay');
            if (drawer.classList.contains('open')) {
                drawer.classList.remove('open');
                overlay.classList.add('hidden');
            } else {
                drawer.classList.add('open');
                overlay.classList.remove('hidden');
            }
        }


        // --- INITIALIZATION ---
        window.onload = function() {
            // Apply initial dark mode state to toggle
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            document.getElementById('dark-mode-toggle').checked = isDarkMode;
            
            const isLargeFont = localStorage.getItem('fontSizeBase') === '1.125rem';
            document.getElementById('font-size-toggle').checked = isLargeFont;

            // Start on the Math view by default
            switchView('math'); 
        };
    </script>
