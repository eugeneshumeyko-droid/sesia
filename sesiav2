                // Prevent scrolling when dragging
                if (e.target.closest('.floating-window-header')) {
                    e.preventDefault(); 
                    const touch = e.touches[0];
                    pos3 = touch.clientX;
                    pos4 = touch.clientY;
                    document.ontouchend = closeDragElement;
                    document.ontouchmove = elementDragTouch;
                }
            }

            function elementDrag(e) {
                e = e || window.event;
                e.preventDefault();
                // Calculate the new cursor position:
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                // Set the element's new position:
                let newTop = element.offsetTop - pos2;
                let newLeft = element.offsetLeft - pos1;

                // Simple boundary check
                newTop = Math.max(0, newTop);
                newLeft = Math.max(0, newLeft);
                
                element.style.top = newTop + "px";
                element.style.left = newLeft + "px";
            }
            
            function elementDragTouch(e) {
                e = e || window.event;
                e.preventDefault(); // Prevents scrolling
                const touch = e.touches[0];
                // Calculate the new cursor position:
                pos1 = pos3 - touch.clientX;
                pos2 = pos4 - touch.clientY;
                pos3 = touch.clientX;
                pos4 = touch.clientY;
                // Set the element's new position:
                let newTop = element.offsetTop - pos2;
                let newLeft = element.offsetLeft - pos1;
                
                // Simple boundary check
                newTop = Math.max(0, newTop);
                newLeft = Math.max(0, newLeft);

                element.style.top = newTop + "px";
                element.style.left = newLeft + "px";
            }


            function closeDragElement() {
                /* stop moving when mouse button is released:*/
                document.onmouseup = null;
                document.onmousemove = null;
                document.ontouchend = null;
                document.ontouchmove = null;
            }
        }
        
        // --- WINDOW FLASHCARD LOGIC ---

        function renderWindowFlashcards(windowId, cards) {
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index') || 0);

            if (currentCardIndex >= cards.length) currentCardIndex = 0;
            if (cards.length === 0) return;
            
            const currentCard = cards[currentCardIndex];
            const isFlipped = activeFlippedCards[windowId] || false;
            
            const cardHTML = `
                <div class="flashcard-window-content w-full h-40 relative">
                    <div id="${windowId}-flashcard" class="flashcard-small ${isFlipped ? 'flipped' : ''}" onclick="flipWindowCard('${windowId}')">
                        <div class="flashcard-face flashcard-front">
                            ${currentCard.term}
                        </div>
                        <div class="flashcard-face flashcard-back text-left">
                            ${currentCard.definition}
                        </div>
                    </div>
                </div>
            `;

            const controlsHTML = `
                <div class="flex justify-center items-center mt-4 space-x-4">
                    <button onclick="prevWindowCard('${windowId}', ${JSON.stringify(cards).replace(/"/g, '&quot;')})" class="p-2 rounded-full bg-gray-300 dark:bg-gray-600 text-primary-default dark:text-white hover:bg-gray-400 dark:hover:bg-gray-500 disabled:opacity-50 transition duration-150 text-sm" ${currentCardIndex === 0 ? 'disabled' : ''} title="Попередня картка">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                    </button>
                    
                    <span class="text-sm font-semibold text-text-default">${currentCardIndex + 1} / ${cards.length}</span>

                    <button onclick="nextWindowCard('${windowId}', ${JSON.stringify(cards).replace(/"/g, '&quot;')})" class="p-2 rounded-full bg-gray-300 dark:bg-gray-600 text-primary-default dark:text-white hover:bg-gray-400 dark:hover:bg-gray-500 disabled:opacity-50 transition duration-150 text-sm" ${currentCardIndex === cards.length - 1 ? 'disabled' : ''} title="Наступна картка">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                    </button>
                </div>
            `;

            document.getElementById(`${windowId}-flashcards-content`).innerHTML = `
                <div class="bg-secondary-bg dark:bg-gray-800 p-4 rounded-lg border border-gray-200 dark:border-gray-700">
                    ${cardHTML}
                    ${controlsHTML}
                </div>
            `;
            document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex);
        }

        function flipWindowCard(windowId) {
            const card = document.getElementById(`${windowId}-flashcard`);
            activeFlippedCards[windowId] = !activeFlippedCards[windowId];
            if (activeFlippedCards[windowId]) {
                card.classList.add('flipped');
            } else {
                card.classList.remove('flipped');
            }
        }

        function nextWindowCard(windowId, cards) {
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index'));
            if (currentCardIndex < cards.length - 1) {
                document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex + 1);
                activeFlippedCards[windowId] = false; // Reset flip
                renderWindowFlashcards(windowId, cards);
            }
        }

        function prevWindowCard(windowId, cards) {
            let currentCardIndex = parseInt(document.getElementById(windowId).getAttribute('data-card-index'));
            if (currentCardIndex > 0) {
                document.getElementById(windowId).setAttribute('data-card-index', currentCardIndex - 1);
                activeFlippedCards[windowId] = false; // Reset flip
                renderWindowFlashcards(windowId, cards);
            }
        }


        // --- SETTINGS LOGIC ---
        function toggleSettings() {
            const drawer = document.getElementById('settings-drawer');
            const overlay = document.getElementById('settings-overlay');
            if (drawer.classList.contains('open')) {
                // Close the drawer
                drawer.classList.remove('open');
                overlay.classList.add('hidden');
            } else {
                // Open the drawer
                drawer.classList.add('open');
                overlay.classList.remove('hidden');
            }
        }


        // --- INITIALIZATION ---
        window.onload = function() {
            // Apply initial dark mode state to toggle
            const isDarkMode = localStorage.getItem('darkMode') === 'true';
            document.getElementById('dark-mode-toggle').checked = isDarkMode;
            
            const isLargeFont = localStorage.getItem('fontSizeBase') === '1.125rem';
            document.getElementById('font-size-toggle').checked = isLargeFont;

            // Start on the Math view by default
            switchView('math'); 
        };
    </script>
</body>
