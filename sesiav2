    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        // --- TAILWIND CONFIGURATION ---
        tailwind.config = {
            darkMode: 'class', // Enable dark mode based on 'dark' class
            theme: {
                extend: {
                    colors: {
                        // Custom colors linked to CSS variables for dynamic theme changes
                        'primary-default': 'var(--primary-color)',
                        'primary-accent': 'var(--accent-color)',
                        'secondary-bg': 'var(--secondary-bg-color)',
                        'card-bg': 'var(--card-bg-color)',
                        'text-default': 'var(--text-color)',
                        'text-secondary': 'var(--text-secondary-color)',
                    },
                    fontFamily: {
                        // Use Inter as the main font
                        sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
                    },
                    fontSize: {
                        'base-size': 'var(--font-size-base)',
                        'sm-size': 'var(--font-size-sm)',
                    }
                }
            }
        }

        // --- THEME DEFINITIONS ---
        // Blue Accents (Default)
        const bluePrimary = '#2563eb'; // blue-700
        const blueAccent = '#3b82f6'; // blue-500

        // Default Light Theme (Minimalistic White/Light Gray)
        const defaultTheme = {
            '--primary-color': bluePrimary,
            '--accent-color': blueAccent,
            '--secondary-bg-color': '#f9fafb', // Very Light Gray
            '--card-bg-color': '#ffffff',      // Pure White
            '--text-color': '#1f2937',         // Dark Gray Text
            '--text-secondary-color': '#6b7280', // Medium Gray Text
            '--accent-rgb': '59, 130, 246', // RGB for transparency utilities
            '--font-size-base': '1rem',
            '--font-size-sm': '0.875rem',
        };

        // Dark Theme (FIXED: Improved Contrast)
        const darkTheme = {
            '--primary-color': '#93c5fd', // Light blue for contrast
            '--accent-color': '#60a5fa',  // Slightly brighter accent
            '--secondary-bg-color': '#111111', // Near Black background (Body)
            '--card-bg-color': '#1f1f1f',      // Darker Card background for separation and better contrast (Main Container)
            '--text-color': '#f3f4f6',         // Near white text
            '--text-secondary-color': '#a1a1aa', // Lighter secondary text
            '--accent-rgb': '96, 165, 250', // RGB for transparency utilities
        };

        // --- THEME APPLICATION LOGIC ---
        
        function applyTheme(isDark) {
            const root = document.documentElement;
            const theme = isDark ? darkTheme : defaultTheme;
            
            if (isDark) {
                root.classList.add('dark');
            } else {
                root.classList.remove('dark');
            }
            
            // Apply base theme settings
            for (const [key, value] of Object.entries(theme)) {
                // Do not override font sizes here, they are handled separately for persistence
                if (!key.includes('font-size')) {
                    root.style.setProperty(key, value);
                }
            }
            
            // Re-apply preserved accent color if custom one exists (overrides default/dark theme colors)
            const storedPrimary = localStorage.getItem('primaryColor');
            const storedAccent = localStorage.getItem('accentColor');
            const storedAccentRgb = localStorage.getItem('accentColorRgb');

            if (storedPrimary && storedAccent && storedAccentRgb) {
                root.style.setProperty('--primary-color', storedPrimary);
                root.style.setProperty('--accent-color', storedAccent);
                root.style.setProperty('--accent-rgb', storedAccentRgb);
            }

            // Preserve font size setting
            applyFontSize(localStorage.getItem('fontSizeBase') === '1.125rem', false);
        }
        
        // Initial setup from localStorage
        const isDarkMode = localStorage.getItem('darkMode') === 'true';
        applyTheme(isDarkMode);

        // Function to toggle dark mode
        function toggleDarkMode(isDark) {
            localStorage.setItem('darkMode', isDark);
            applyTheme(isDark);
            // Update the checkbox if called externally
            const toggle = document.getElementById('dark-mode-toggle');
            if (toggle) toggle.checked = isDark;
        }
        
        // Helper to convert hex to RGB (needed for transparent backgrounds)
        function hexToRgb(hex) {
            let bigint = parseInt(hex.slice(1), 16);
            let r = (bigint >> 16) & 255;
            let g = (bigint >> 8) & 255;
            let b = bigint & 255;
            return `${r}, ${g}, ${b}`;
        }


        // Function to change accent color
        function changeAccentColor(primary, accent) {
            const accentRgb = hexToRgb(accent);
            document.documentElement.style.setProperty('--primary-color', primary);
            document.documentElement.style.setProperty('--accent-color', accent);
            document.documentElement.style.setProperty('--accent-rgb', accentRgb);
            
            localStorage.setItem('primaryColor', primary);
            localStorage.setItem('accentColor', accent);
            localStorage.setItem('accentColorRgb', accentRgb);
        }

        // Function to change font size
        function applyFontSize(isLarge, saveToStorage = true) {
            const base = isLarge ? '1.125rem' : '1rem';
            const sm = isLarge ? '1rem' : '0.875rem';
            document.documentElement.style.setProperty('--font-size-base', base);
            document.documentElement.style.setProperty('--font-size-sm', sm);
            if (saveToStorage) {
                localStorage.setItem('fontSizeBase', base);
                localStorage.setItem('fontSizeSm', sm);
            }
        }

        // Initialize with stored settings if available
        document.addEventListener('DOMContentLoaded', () => {
            // Color is already handled by applyTheme called on load
            
            // Initialize font size control
            const isLarge = localStorage.getItem('fontSizeBase') === '1.125rem';
            applyFontSize(isLarge, false); // Apply without saving again
            const sizeToggle = document.getElementById('font-size-toggle');
            if (sizeToggle) sizeToggle.checked = isLarge;
        });

    </script>
    
