        // Використовуємо дані з підручників "Алгебра, 7 клас, Істер" та "Українська мова, 7 клас, Заболотний"
        const sessionTopics = {
            'math': {
                title: 'Алгебра: Основні теми (Істер, 7 клас)',
                items: [
                    {
                        title: "§3. Лінійне рівняння з однією змінною (С. 19)",
                        content: `
                            <p>Рівняння виду $ax = b$, де $x$ — змінна, $a$ і $b$ — деякі числа, називається лінійним рівнянням з однією змінною.</p>
                            <p><strong>Розв'язання:</strong></p>
                            <ul class="list-disc ml-6 space-y-1 mt-2">
                                <li>Якщо $a \\ne 0$, то $x = \\frac{b}{a}$ (єдиний корінь).</li>
                                <li>Якщо $a = 0$ і $b = 0$, то $0x = 0$ (безліч коренів, будь-яке число).</li>
                                <li>Якщо $a = 0$ і $b \\ne 0$, то $0x = b$ (немає коренів).</li>
                            </ul>
                        `,
                        flashcards: [
                            { term: "Означення лінійного рівняння", definition: "Рівняння виду $ax = b$." },
                            { term: "Випадок $a \\ne 0$", definition: "Єдиний корінь: $x = \\frac{b}{a}$." },
                            { term: "Випадок $a = 0, b = 0$", definition: "Безліч коренів ($0x=0$)." },
                            { term: "Випадок $a = 0, b \\ne 0$", definition: "Немає коренів ($0x=b$)." }
                        ]
                    },
                    {
                        title: "§5. Тотожні вирази. Тотожність (С. 32)",
                        content: `
                            <p><strong>Тотожні вирази</strong> — це вирази, відповідні значення яких рівні при будь-яких допустимих значеннях змінних. Наприклад, $a(a+1)$ і $a^2 + a$.</p>
                            <p><strong>Тотожність</strong> — це рівність, яка є правильною при будь-яких допустимих значеннях змінних, що входять до її складу.</p>
                            <p><strong>Доведення тотожностей:</strong></p>
                            <ul class="list-disc ml-6 space-y-1 mt-2">
                                <li>Перетворити одну частину рівності на іншу.</li>
                                <li>Обидві частини звести до одного й того ж виразу.</li>
                                <li>Довести, що різниця лівої та правої частин дорівнює нулю.</li>
                            </ul>
                        `,
                        flashcards: [
                             { term: "Що таке тотожні вирази?", definition: "Вирази, рівні при будь-яких допустимих значеннях змінних." },
                            { term: "Що таке тотожність?", definition: "Рівність, правильна при будь-яких допустимих значеннях змінних." }
                        ]
                    },
                    {
                        title: "§6. Степінь з натуральним показником (С. 37)",
                        content: `
                            <p><strong>Степінь</strong> — це добуток $n$ однакових множників, кожен з яких дорівнює $a$. $a^n = a \\cdot a \\cdot ... \\cdot a$ ($n$ разів).</p>
                            <p><strong>Особливі випадки:</strong> $a^1 = a$. Якщо $a \\ne 0$, то $a^0 = 1$.</p>
                            <p><strong>Властивості:</strong></p>
                            <ul class="list-disc ml-6 space-y-1 mt-2">
                                <li>Множення: $a^m \\cdot a^n = a^{m+n}$</li>
                                <li>Ділення: $\\frac{a^m}{a^n} = a^{m-n}$ (при $m > n$)</li>
                                <li>Піднесення до степеня: $(a^m)^n = a^{m \\cdot n}$</li>
                                <li>Степінь добутку: $(ab)^n = a^n b^n$</li>
                            </ul>
                        `,
                         flashcards: [
                            { term: "Властивість множення степенів", definition: "$a^m \\cdot a^n = a^{m+n}$" },
                            { term: "Властивість піднесення степеня до степеня", definition: "$(a^m)^n = a^{m \\cdot n}$" }
                        ]
                    },
                    {
                        title: "§9. Одночлен. Стандартний вигляд (С. 60)",
                        content: `
                            <p><strong>Одночлен</strong> — це добуток чисел, змінних та їхніх степенів. Наприклад, $5x^2y^3$.</p>
